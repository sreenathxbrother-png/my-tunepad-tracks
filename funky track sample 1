    playNote(36, 0.5)   # Kick Drum
    playNote(42, 0.5)   # Closed Hi-hat
    
    # Beat 4: Snare and a quick Hi-hat turnaround
    playNote(38, 0.5)   # Snare Drum
    playNote(42, 0.25)  # Closed Hi-hat
    playNote(42, 0.25)  # Closed Hi-hat New TunePad cell



